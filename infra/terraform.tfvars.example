# This file is a generic fallback / reference only. For an actual
# deployment, use the per-environment files in envs/ instead:
#   terraform apply -var-file=envs/test.tfvars
#   terraform apply -var-file=envs/prod.tfvars
# See RUNBOOK.md for the full first-time bootstrap and ongoing-deploy sequence.

# Copy to terraform.tfvars and fill in, OR export as TF_VAR_* env vars
# (preferred for db_password / jwt_secret / smtp_password so secrets never
# touch disk).

project_id = "your-gcp-project-id"
region     = "us-central1"
app_name   = "oncall-pro"

# db_password = "..."   # prefer: export TF_VAR_db_password=$(openssl rand -base64 24)
# jwt_secret  = "..."   # prefer: export TF_VAR_jwt_secret=$(openssl rand -base64 48)
# smtp_password = "..." # prefer: export TF_VAR_smtp_password=...

# Required — no default, must be set:
# alert_notification_email = "you@example.com"

# cors_origin updated automatically by scripts/deploy.sh after the web
# service's URL is known; only set this manually if deploying by hand.
# cors_origin = "https://oncall-pro-web-xxxxx-uc.a.run.app"
