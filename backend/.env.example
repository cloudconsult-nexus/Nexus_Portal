# Copy to .env for local development. On Cloud Run these are set via
# Secret Manager + --set-env-vars in the deploy script / Terraform instead.

NODE_ENV=development
PORT=8080

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Local Postgres (TCP). Leave INSTANCE_CONNECTION_NAME unset locally —
# it's only used on Cloud Run to switch to the Cloud SQL unix socket.
DB_HOST=localhost
DB_PORT=5432
DB_USER=oncallpro
DB_PASSWORD=localdevpassword
DB_NAME=oncallpro

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Branding logo uploads. Leave BRANDING_BUCKET_NAME unset locally — uploads
# fall back to local disk (backend/uploads/), served from PUBLIC_API_URL.
# On Cloud Run, Terraform sets BRANDING_BUCKET_NAME and uploads go to GCS
# instead (see infra/storage.tf).
# BRANDING_BUCKET_NAME=
PUBLIC_API_URL=http://localhost:8080

# Invitations. How long an invite link stays valid before it's shown as
# "expired" on the Invitations tracking page.
INVITE_EXPIRY_DAYS=7

# Invite/password-reset emails. Leave SMTP_HOST unset locally — emails are
# logged to the console instead of sent (see lib/email.js), and the invite
# link is still returned in the API response either way.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@nexusportal.app

# Reporting integration framework — signing secret used for SSO-embedded
# report dashboards when a mapping doesn't set its own sso_shared_secret.
# Deliberately separate from JWT_SECRET (which authenticates our own users)
# since this one may end up configured to match a third-party BI tool.
# REPORT_SSO_FALLBACK_SECRET=

# Customer Messages embed. Leave CUSTOMER_MESSAGING_URL unset locally — the
# Customer Messages page falls back to its "not connected yet" placeholder
# (see routes/customerMessages.js). Set the SSO secret to match whatever the
# messaging platform expects for its signed-embed/trusted-auth token param.
# CUSTOMER_MESSAGING_URL=
# CUSTOMER_MESSAGING_SSO_SECRET=
# CUSTOMER_MESSAGING_TOKEN_PARAM=token
